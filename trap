#include <stdio.h>

double f(double x)
{
    return x * x * x;
}

int main()
{
    double a, b, h, sum, result;
    int n, i;

    printf("Enter lower limit a: ");
    scanf("%lf", &a);

    printf("Enter upper limit b: ");
    scanf("%lf", &b);

    printf("Enter number of subintervals n: ");
    scanf("%d", &n);

    h = (b - a) / n;

    sum = f(a) + f(b);

    for (i = 1; i < n; i++)
    {
        sum += 2 * f(a + i * h);
    }

    result = (h / 2) * sum;

    printf("\nh = %.4f\n", h);
    printf("Integral (Trapezoidal rule) = %.6f\n", result);
    printf("Exact value = %.6f\n", 4.0);

    return 0;
}
