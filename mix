#include<stdio.h>
#include<conio.h>

void main()
{
    int i, n=6;
    double a=0, b=1, h, x, sum;
    double trap, simp13, simp38;

    clrscr();

    h=(b-a)/n;

    sum=0;
    for(i=1;i<n;i++)
    {
        x=a+i*h;
        sum=sum+x*x;
    }
    trap=(h/2)*(a*a+b*b+2*sum);

    sum=0;
    for(i=1;i<n;i++)
    {
        x=a+i*h;
        if(i%2==0)
            sum=sum+2*x*x;
        else
            sum=sum+4*x*x;
    }
    simp13=(h/3)*(a*a+b*b+sum);

    sum=0;
    for(i=1;i<n;i++)
    {
        x=a+i*h;
        if(i%3==0)
            sum=sum+2*x*x;
        else
            sum=sum+3*x*x;
    }
    simp38=(3*h/8)*(a*a+b*b+sum);

    printf("\nTrapezoidal Rule = %lf",trap);
    printf("\nSimpson's 1/3 Rule = %lf",simp13);
    printf("\nSimpson's 3/8 Rule = %lf",simp38);

    printf("\n\nExact Value = %lf",1.0/3);

    getch();
}
