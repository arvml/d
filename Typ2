t<-c(85,151,280,376,492,520,623,715,820,914)
n<-60
r<-10
s1<-(sum(t)+(n-r)*t[r])/r;s1
MLE=function(t,s){exp(-t/s)}
t1=seq(0,10000,by=0.1)
plot(t1,MLE(t1,s1),type="l")
t2<-seq(0,r*s1,by=0.1)
UMVUE=function(r,t,s){(1-t/(r*s))^(r-1)}
plot(t2,UMVUE(r,t2,s1),type="l")

diff=function(t2){abs(MLE(t2,s1)-UMVUE(r,t2,s1))}
max_index<-which.max(diff(t2))
t2[max_index]
diff(3052.9)
