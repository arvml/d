#include <stdio.h>
#include <math.h>

double f(double x)
{
    return 1 / (1 + x * x);
}

int main()
{
    double a, b, h, sum, result;
    int n, i;

    printf("Enter lower limit a: ");
    scanf("%lf", &a);

    printf("Enter upper limit b: ");
    scanf("%lf", &b);

    printf("Enter number of subintervals n (multiple of 3): ");
    scanf("%d", &n);

    if (n % 3 != 0)
    {
        printf("n must be a multiple of 3.\n");
        return 0;
    }

    h = (b - a) / n;
    sum = f(a) + f(b);

    for (i = 1; i < n; i++)
    {
        if (i % 3 == 0)
            sum += 2 * f(a + i * h);
        else
            sum += 3 * f(a + i * h);
    }

    result = (3 * h / 8) * sum;

    printf("\nh = %.4f\n", h);
    printf("Integral (Simpson's 3/8 rule) = %.6f\n", result);
    printf("Exact value (pi/4) = %.6f\n", atan(1.0));

    return 0;
}
